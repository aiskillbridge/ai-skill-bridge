# Server-only (Vercel Environment Variables — never expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# Required: exactly "stage" or "production" (no default; invalid → payment_not_configured)
ECPAY_MODE=stage
APP_BASE_URL=

# Purchase confirmation email (Resend). Server-only — never expose to browser.
# Production (VERCEL_ENV=production): email sends ONLY when ALL are true:
#   PURCHASE_EMAIL_MODE=production
#   PURCHASE_EMAIL_FROM uses your verified custom domain (NOT @resend.dev)
#   RESEND_API_KEY or EMAIL_PROVIDER_API_KEY is set
# Until then, callback skips email safely — paid / entitlement unaffected.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=
# Local test From: AI Skill Bridge <onboarding@resend.dev>
# Production From (after domain verify): AI Skill Bridge <no-reply@aiskillbridge.com>
PURCHASE_EMAIL_FROM=
# test = local / preview / vercel dev ONLY (blocked on Production deploy)
# production = required for Production deploy to send customer emails
PURCHASE_EMAIL_MODE=test
# Local test only — NEVER used on Production deploy (real customer orders)
PURCHASE_EMAIL_TEST_TO=
